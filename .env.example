# --- Entorno ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Red XRPL (testnet | devnet | standalone) ---
XRPL_NETWORK=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Para Modo Standalone (rippled --a en Docker), descomenta estas dos líneas:
# XRPL_NETWORK=standalone
# XRPL_WS_URL=ws://localhost:5005

# --- Objetos XLS-65 / XLS-66 a monitorizar ---
HERMES_VAULT_ID=
HERMES_LOAN_BROKER_ID=

# --- Correlación JSON-RPC y Reconexión ---
RPC_VAULT_REQ_ID=101
RPC_LOAN_BROKER_REQ_ID=102
RPC_REQUEST_TIMEOUT=10.0
WS_RECONNECT_INITIAL_DELAY=1.0
WS_RECONNECT_MAX_DELAY=60.0
WS_RECONNECT_BACKOFF_FACTOR=2.0

# --- Reglas Financieras XLS-65 / XLS-66 ---
FLCR_WARNING_MULTIPLIER=1.20
NAV_QUANTIZER=0.000001
VAULT_PERMISSIONED_MASK=0x0001

# --- Pasarela de Alertas y Circuit Breaker ---
ALERT_QUEUE_MAX_SIZE=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Motor Agéntico (Gemini 4 Hydrogen) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=low
GEMINI_TEMPERATURE=0.1